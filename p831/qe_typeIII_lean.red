load_package redlog;
rlset ofsf;
off nat;
on rlverbose;
phi := ex({t2,t3,t4}, (8*t2^4*t3^3*t4^3 - 4*t2^4*t3^2*t4^4 + 8*t2^4*t3*t4^3 + 8*t2^4*t3*t4 - 4*t2^4*t4^2 - 4*t2^3*t3^4*t4^3 - 4*t2^3*t3^3*t4^4 + 12*t2^3*t3^3*t4^2 - 20*t2^3*t3^2*t4^3 - 12*t2^3*t3^2*t4 - 8*t2^3*t3*t4^4 - 4*t2^3*t3*t4^2 + 4*t2^3*t3 + 8*t2^3*t4^3 - 4*t2^3*t4 + 4*t2^2*t3^4*t4^4 - 8*t2^2*t3^4*t4^2 + 8*t2^2*t3^3*t4^3 + 8*t2^2*t3^3*t4 + 8*t2^2*t3^2*t4^4 - 8*t2^2*t3^2 - 4*t2^2*t4^4 + 8*t2^2*t4^2 + 8*t2*t3^4*t4^3 - 4*t2*t3^4*t4 - 8*t2*t3^3*t4^4 + 12*t2*t3^3*t4^2 + 4*t2*t3^3 - 4*t2*t3^2*t4^3 + 4*t2*t3^2*t4 - 4*t2*t3*t4^4 - 4*t2*t3*t4^2 - 4*t2*t4^3 + 4*t3^4*t4^2 - 8*t3^3*t4^3 + 4*t3^2*t4^4 = 0) and (-4*t2^4*t3^3*t4^3 + 4*t2^4*t3^2*t4^4 - 8*t2^4*t3^2*t4^2 + 8*t2^4*t3*t4^3 - 4*t2^4*t3*t4 + 4*t2^4*t4^2 + 8*t2^3*t3^4*t4^3 - 4*t2^3*t3^3*t4^4 + 12*t2^3*t3^3*t4^2 + 8*t2^3*t3^2*t4^3 + 8*t2^3*t3^2*t4 - 8*t2^3*t3*t4^4 + 12*t2^3*t3*t4^2 + 4*t2^3*t3 - 8*t2^3*t4^3 - 4*t2^2*t3^4*t4^4 - 20*t2^2*t3^3*t4^3 - 12*t2^2*t3^3*t4 + 8*t2^2*t3^2*t4^4 - 8*t2^2*t3^2 - 4*t2^2*t3*t4^3 + 4*t2^2*t3*t4 + 4*t2^2*t4^4 + 8*t2*t3^4*t4^3 + 8*t2*t3^4*t4 - 8*t2*t3^3*t4^4 - 4*t2*t3^3*t4^2 + 4*t2*t3^3 - 4*t2*t3*t4^4 - 4*t2*t3*t4^2 - 4*t3^4*t4^2 + 8*t3^3*t4^3 - 4*t3^3*t4 - 4*t3^2*t4^4 + 8*t3^2*t4^2 - 4*t3*t4^3 = 0) and (32*t2^3*t4^2 - 32*t2^2*t3*t4^2 + 32*t2^2*t4 - 32*t2*t3*t4 <> 0) and (32*t2*t3^2*t4^2 + 32*t2*t3*t4 - 32*t3^3*t4^2 - 32*t3^2*t4 <> 0) and (-32*t2^3*t3*t4^3 - 32*t2^3*t4^2 + 32*t2^2*t3^2*t4^3 + 32*t2^2*t3*t4^4 + 32*t2^2*t4^3 - 32*t2^2*t4 - 32*t2*t3^2*t4^4 + 32*t2*t3^2*t4^2 + 32*t2*t3*t4 + 32*t2*t4^2 - 32*t3^2*t4^3 - 32*t3*t4^2 <> 0) and (-32*t2^2*t3^2*t4^3 + 32*t2^2*t3*t4^4 - 32*t2^2*t3*t4^2 + 32*t2^2*t4^3 + 32*t2*t3^3*t4^3 - 32*t2*t3^2*t4^4 - 32*t2*t3*t4 + 32*t2*t4^2 + 32*t3^3*t4^2 - 32*t3^2*t4^3 + 32*t3^2*t4 - 32*t3*t4^2 <> 0) and (-32*t2^4*t3^2*t4^3 + 32*t2^4*t3*t4^4 - 32*t2^4*t3*t4^2 + 32*t2^4*t4^3 + 64*t2^3*t3^3*t4^3 - 32*t2^3*t3^2*t4^4 + 32*t2^3*t3^2*t4^2 + 64*t2^3*t3*t4^3 - 32*t2^3*t4^4 + 32*t2^3*t4^2 - 32*t2^2*t3^4*t4^3 - 32*t2^2*t3^3*t4^4 + 32*t2^2*t3^3*t4^2 - 192*t2^2*t3^2*t4^3 + 32*t2^2*t3*t4^4 - 32*t2^2*t3*t4^2 - 32*t2^2*t4^3 + 32*t2*t3^4*t4^4 - 32*t2*t3^4*t4^2 + 64*t2*t3^3*t4^3 + 32*t2*t3^2*t4^4 - 32*t2*t3^2*t4^2 + 64*t2*t3*t4^3 + 32*t3^4*t4^3 - 32*t3^3*t4^4 + 32*t3^3*t4^2 - 32*t3^2*t4^3 <> 0));
result := rlqe phi;
write "ANSWER: ", result;
quit;
