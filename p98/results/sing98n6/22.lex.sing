option(redSB);
ring R = 0, (t,x2,x3,x4,x5,y2,y3,y4,y5,d0,d1,d2), dp;
ideal I =
  (0-(1))^2+(0-(0))^2-d0,
  (0-(x2))^2+(0-(y2))^2-d0,
  (0-(x3))^2+(0-(y3))^2-d0,
  (0-(x4))^2+(0-(y4))^2-d1,
  (0-(x5))^2+(0-(y5))^2-d1,
  (1-(x2))^2+(0-(y2))^2-d0,
  (1-(x3))^2+(0-(y3))^2-d1,
  (1-(x4))^2+(0-(y4))^2-d0,
  (1-(x5))^2+(0-(y5))^2-d1,
  (x2-(x3))^2+(y2-(y3))^2-d1,
  (x2-(x4))^2+(y2-(y4))^2-d1,
  (x2-(x5))^2+(y2-(y5))^2-d0,
  (x3-(x4))^2+(y3-(y4))^2-d2,
  (x3-(x5))^2+(y3-(y5))^2-d2,
  (x4-(x5))^2+(y4-(y5))^2-d2,
  d0-1,
  t*(d0-d1)*(d0-d2)*(d1-d2)*d0*d1*d2-1;
ideal G = std(I);
ring S = 0, (t,x2,x3,x4,x5,y2,y3,y4,y5,d0,d1,d2), lp;
ideal J = fglm(R, G);
write(":w /work/sing98n6/22.lex", J);
print("LEX " + string(size(J)));
quit;
