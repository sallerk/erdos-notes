option(redSB);
ring R = 0, (t,u,w,x2,x3,x4,y2,y3,y4,d0,d1,d2,d3), dp;
ideal I =
  (0-(1))^2+(0-(0))^2-d0,
  (0-(x2))^2+(0-(y2))^2-d0,
  (0-(x3))^2+(0-(y3))^2-d0,
  (0-(x4))^2+(0-(y4))^2-d1,
  (1-(x2))^2+(0-(y2))^2-d0,
  (1-(x3))^2+(0-(y3))^2-d1,
  (1-(x4))^2+(0-(y4))^2-d0,
  (x2-(x3))^2+(y2-(y3))^2-d2,
  (x2-(x4))^2+(y2-(y4))^2-d3,
  (x3-(x4))^2+(y3-(y4))^2-d1,
  d0-1,
  t*(d0-d1)*(d0-d2)*(d0-d3)*(d1-d2)*(d1-d3)*(d2-d3)*d0*d1*d2*d3-1,
  u*(y2)*(y3)*(y4)*(x2*y3 - x3*y2)*(x2*y4 - x4*y2)*(x3*y4 - x4*y3)*(x2*y3 - x3*y2 + y2 - y3)*(x2*y4 - x4*y2 + y2 - y4)*(x3*y4 - x4*y3 + y3 - y4)*(x2*y3 - x2*y4 - x3*y2 + x3*y4 + x4*y2 - x4*y3)-1,
  w*(x2^2*y3 - x2*y3 - x3^2*y2 + x3*y2 + y2^2*y3 - y2*y3^2)*(x2^2*y4 - x2*y4 - x4^2*y2 + x4*y2 + y2^2*y4 - y2*y4^2)*(x3^2*y4 - x3*y4 - x4^2*y3 + x4*y3 + y3^2*y4 - y3*y4^2)*(-x2^2*x3*y4 + x2^2*x4*y3 + x2*x3^2*y4 - x2*x4^2*y3 + x2*y3^2*y4 - x2*y3*y4^2 - x3^2*x4*y2 + x3*x4^2*y2 - x3*y2^2*y4 + x3*y2*y4^2 + x4*y2^2*y3 - x4*y2*y3^2)*(-x2^2*x3*y4 + x2^2*x4*y3 - x2^2*y3 + x2^2*y4 + x2*x3^2*y4 - x2*x4^2*y3 + x2*y3^2*y4 - x2*y3*y4^2 + x2*y3 - x2*y4 - x3^2*x4*y2 + x3^2*y2 - x3^2*y4 + x3*x4^2*y2 - x3*y2^2*y4 + x3*y2*y4^2 - x3*y2 + x3*y4 - x4^2*y2 + x4^2*y3 + x4*y2^2*y3 - x4*y2*y3^2 + x4*y2 - x4*y3 - y2^2*y3 + y2^2*y4 + y2*y3^2 - y2*y4^2 - y3^2*y4 + y3*y4^2)-1;
ideal G = std(I);
ring S = 0, (t,u,w,x2,x3,x4,y2,y3,y4,d0,d1,d2,d3), lp;
ideal J = fglm(R, G);
write(":w /work/sing98wF/3.lex", J);
print("LEX " + string(size(J)));
quit;
